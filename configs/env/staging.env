# This SDLC env file should be used to override or add additional environment variables than the ones in the .env
#   when the APP_ENV value in the .env file points to this env file
# The values for the variables included in this env file will override the ones that are set in the '.env' (root) file
# The values for the variables included in the env; but NOT in this .env file will be used for deployment to the
# The APP_ENV is used to point to the associated env file for the varous 'SDLC" environments (dev/staging/live)
# Any values for identical environment variable name in the associated SDLC env file will override
APP_ENV=staging
APP_DISPLAY_SEC=600
# DO NOT CHANGE THE APP_HOME VALUE FOR USE IN SDLC ENVIRONMENTS.  IT IS REQUIRED FOR THE CONTAINER TO RUN.
APP_HOME=/home/appuser
APP_NAME=vendor-rewards-processor

# Loggers
LOGGER_LEVEL=INFO
KAFKA_LOGGER_LEVEL=CRITICAL
MSA_TOOLKIT_LOGGER_LEVEL=INFO

# Kafka Stuff
APP_KAFKA_HOSTS=kafka-d01.maeagle.corp:9092,kafka-d02.maeagle.corp:9092,kafka-d03.maeagle.corp:9092
APP_KAFKA_GROUP_ID=vendor-rewards-processor-data-consumer
APP_KAFKA_TOPIC=staging-pyjob-vendor-rewards-processor-default
APP_KAFKA_SETTINGS_AUTOCOMMIT=True
APP_KAFKA_SETTINGS_AUTOOFFSETRESET=earliest

# Kafka Diagnostics (Metrics, Alerts, and Transaction) messages
KAFKA_ALERTS_HOSTS=kafka-d01:9092,kafka-d02:9092,kafka-d03:9092
KAFKA_ALERTS_TOPIC=staging-pyjob-alerts-log
KAFKA_GROUP_ID=staging-pyjob-vendor-rewards-processor-default-diagnostics
KAFKA_METRICS_HOSTS=kafka-d01:9092,kafka-d02:9092,kafka-d03:9092
KAFKA_METRICS_TOPIC=staging-pyjob-metrics-log
KAFKA_TRANSACTIONS_HOSTS=kafka-d01:9092,kafka-d02:9092,kafka-d03:9092
KAFKA_TRANSACTIONS_TOPIC=staging-pyjob-transactions-log

#DSB
DSB_BASE_URL=http://dev-dsb.bird.com
DSB_RESOURCE=/dataEngine/rest/dataretrieval/redback/dmc/UTIL/Service/setUtilUVUpdate